// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SynthesisContent > matches the snapshot for a fully populated synthesis 1`] = `"<article class="flex flex-col gap-24"><header class="flex flex-col gap-6 border-b border-hair pb-12"><span class="font-mono text-[12px] uppercase tracking-[0.14em] text-ink-label">Synthesis · AHR-2026-DE</span><div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"><div class="flex max-w-[720px] flex-col gap-5"><h1 class="font-serif text-[56px] leading-[1.05] text-ink-primary lg:text-[64px]">Where the table arrived, <em class="not-italic text-accent-rust italic">together.</em></h1><p class="text-[16px] leading-7 text-ink-body">Three rounds in, the chamber settles. The neutral judge reads the transcript end to end and lays out the fault lines, the agreements, and the shape of a workable compromise - without taking a side.</p><p class="text-[12px] uppercase tracking-[0.14em] text-ink-label">Concluded Apr 11</p></div><div class="flex flex-wrap items-center gap-3"><a class="inline-flex h-12 items-center justify-center rounded-full bg-surface px-6 text-[14px] font-medium text-ink-primary transition-colors hover:bg-surface-mut" href="/debates/debate-001">← Back to debate</a><button type="button" class="inline-flex h-12 items-center justify-center rounded-full bg-ink-button px-6 text-[14px] font-medium text-cream transition-colors hover:opacity-90">Export</button></div></div></header><section class="grid grid-cols-1 gap-6 lg:grid-cols-3"><article class="flex flex-col gap-6 rounded-2xl border border-hair px-8 py-8 bg-surface"><div class="flex items-center gap-3"><span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:var(--color-persona-terracotta)"></span><h2 class="font-serif text-[24px] leading-tight text-ink-primary">Contradictions</h2></div><ol class="flex flex-col gap-5"><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">1</span><p class="text-[15px] leading-[22px] text-ink-body">Tenants treat rent caps as protection; operators treat them as expropriation.</p></li><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">2</span><p class="text-[15px] leading-[22px] text-ink-body">Builders want predictability; council wants flexibility to revise yearly.</p></li><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">3</span><p class="text-[15px] leading-[22px] text-ink-body">First-time buyers feel sidelined by both sides of the rental debate.</p></li></ol></article><article class="flex flex-col gap-6 rounded-2xl border border-hair px-8 py-8 bg-surface"><div class="flex items-center gap-3"><span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:var(--color-persona-sage)"></span><h2 class="font-serif text-[24px] leading-tight text-ink-primary">Common ground</h2></div><ol class="flex flex-col gap-5"><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">1</span><p class="text-[15px] leading-[22px] text-ink-body">Everyone accepts that current rental volatility is unsustainable.</p></li><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">2</span><p class="text-[15px] leading-[22px] text-ink-body">All sides agree new construction must continue, not stall.</p></li><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">3</span><p class="text-[15px] leading-[22px] text-ink-body">The chamber accepts a phased introduction over a cliff edge.</p></li></ol></article><article class="flex flex-col gap-6 rounded-2xl border border-hair px-8 py-8 bg-surface-2"><div class="flex items-center gap-3"><span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full" style="background-color:var(--color-persona-mustard)"></span><h2 class="font-serif text-[24px] leading-tight text-ink-primary">Compromise</h2></div><ol class="flex flex-col gap-5"><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">1</span><p class="text-[15px] leading-[22px] text-ink-body">Apply a 4% annual cap in regulated zones with a sunset clause after three years.</p></li><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">2</span><p class="text-[15px] leading-[22px] text-ink-body">Exempt buildings under five units to protect small operators.</p></li><li class="grid grid-cols-[32px_1fr] items-baseline gap-3"><span class="font-serif text-[28px] italic leading-none text-accent-rust">3</span><p class="text-[15px] leading-[22px] text-ink-body">Pair the cap with a tax credit to keep new construction on the table.</p></li></ol></article></section><section class="flex flex-col gap-6"><div class="flex flex-col gap-2"><p class="text-[11px] font-medium uppercase tracking-[0.18em] text-ink-label">By participant</p><h2 class="font-serif text-[36px] leading-[1.1] text-ink-primary">How each seat shifted.</h2></div><div class="flex flex-col"><article class="grid grid-cols-1 gap-6 border-t border-hair py-8 lg:grid-cols-[200px_1fr_140px_1fr_80px] lg:items-center lg:gap-8"><div class="flex items-center gap-3"><span class="inline-flex shrink-0 items-center justify-center font-medium text-cream  " style="width:40px;height:40px;min-width:40px;min-height:40px;border-radius:50%;background-color:var(--color-persona-sage);font-size:16px;line-height:1" aria-label="Mira K.">M</span><div class="flex flex-col"><span class="text-[15px] text-ink-primary">Mira K.</span><span class="text-[12px] text-ink-muted">Long-term tenant</span></div></div><div class="flex flex-col gap-1.5"><span class="text-[11px] uppercase tracking-[0.18em] text-ink-label">Opened R1</span><p class="font-serif text-[16px] italic leading-[22px] text-ink-body">“tenants need predictable rents.”</p></div><div class="flex justify-center"><svg viewBox="0 0 120 28" width="120" height="28" aria-hidden="true" class="block"><line x1="10" x2="110" y1="14" y2="14" stroke="var(--color-hair)" stroke-width="1" stroke-linecap="round"></line><circle cx="10" cy="14" r="5" fill="var(--color-surface)" stroke="var(--color-persona-sage)" stroke-width="2"></circle><circle cx="60" cy="14" r="5" fill="var(--color-persona-sage)" fill-opacity="0.431" stroke="var(--color-persona-sage)" stroke-width="2"></circle><circle cx="110" cy="14" r="5" fill="var(--color-persona-sage)" stroke="var(--color-persona-sage)" stroke-width="2"></circle></svg></div><div class="flex flex-col gap-1.5"><span class="text-[11px] uppercase tracking-[0.18em] text-ink-label">Closed R3</span><p class="font-serif text-[16px] italic leading-[22px] text-ink-body">“a phased cap with review keeps tenants protected.”</p></div><div class="flex flex-col items-start lg:items-end"><span class="font-serif text-[40px] italic leading-none text-ink-primary">18%</span><span class="mt-1 text-[11px] uppercase tracking-[0.18em] text-ink-label">Shift</span></div></article><article class="grid grid-cols-1 gap-6 border-t border-hair py-8 lg:grid-cols-[200px_1fr_140px_1fr_80px] lg:items-center lg:gap-8"><div class="flex items-center gap-3"><span class="inline-flex shrink-0 items-center justify-center font-medium text-cream  " style="width:40px;height:40px;min-width:40px;min-height:40px;border-radius:50%;background-color:var(--color-persona-rust);font-size:16px;line-height:1" aria-label="Stoyan P.">S</span><div class="flex flex-col"><span class="text-[15px] text-ink-primary">Stoyan P.</span><span class="text-[12px] text-ink-muted">Building operator</span></div></div><div class="flex flex-col gap-1.5"><span class="text-[11px] uppercase tracking-[0.18em] text-ink-label">Opened R1</span><p class="font-serif text-[16px] italic leading-[22px] text-ink-body">“a cap would freeze new construction.”</p></div><div class="flex justify-center"><svg viewBox="0 0 120 28" width="120" height="28" aria-hidden="true" class="block"><line x1="10" x2="110" y1="14" y2="14" stroke="var(--color-hair)" stroke-width="1" stroke-linecap="round"></line><circle cx="10" cy="14" r="5" fill="var(--color-surface)" stroke="var(--color-persona-rust)" stroke-width="2"></circle><circle cx="60" cy="14" r="5" fill="var(--color-persona-rust)" fill-opacity="0.5389999999999999" stroke="var(--color-persona-rust)" stroke-width="2"></circle><circle cx="110" cy="14" r="5" fill="var(--color-persona-rust)" stroke="var(--color-persona-rust)" stroke-width="2"></circle></svg></div><div class="flex flex-col gap-1.5"><span class="text-[11px] uppercase tracking-[0.18em] text-ink-label">Closed R3</span><p class="font-serif text-[16px] italic leading-[22px] text-ink-body">“with an sme carve-out i can live with a phased cap.”</p></div><div class="flex flex-col items-start lg:items-end"><span class="font-serif text-[40px] italic leading-none text-ink-primary">42%</span><span class="mt-1 text-[11px] uppercase tracking-[0.18em] text-ink-label">Shift</span></div></article><div class="border-t border-hair"></div></div></section><section class="rounded-2xl border border-hair bg-surface-2 px-10 py-10"><div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-8"><div class="flex flex-col items-center gap-2 lg:items-start"><span aria-hidden="true" class="inline-flex h-16 w-16 items-center justify-center rounded-full font-serif text-[36px] text-cream" style="background-color:var(--color-persona-aubergine)">§</span></div><div class="flex flex-1 flex-col gap-3"><p class="text-[11px] font-medium uppercase tracking-[0.18em] text-ink-label">Closing · Neutral judge</p><blockquote class="font-serif text-[26px] italic leading-[1.35] text-ink-primary">“the chamber leaves with a workable shape, not a settled one.”</blockquote></div></div></section><footer class="flex flex-col gap-4 border-t border-hair pt-10 sm:flex-row sm:items-center sm:justify-between"><a class="inline-flex h-12 items-center justify-center rounded-full bg-ink-button px-6 text-[14px] font-medium text-cream transition-colors hover:opacity-90" href="/">← Back to dashboard</a><div class="flex flex-wrap items-center gap-3"><button type="button" class="inline-flex h-12 items-center justify-center rounded-full bg-surface px-6 text-[14px] font-medium text-ink-primary transition-colors hover:bg-surface-mut">Re-run with new participants</button><button type="button" class="inline-flex h-12 items-center justify-center rounded-full bg-surface px-6 text-[14px] font-medium text-ink-primary transition-colors hover:bg-surface-mut">Share synthesis</button></div></footer></article>"`;
