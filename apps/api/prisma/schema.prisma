generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  debates Debate[]

  @@map("users")
}

model Debate {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String
  billText   String   @map("bill_text") @db.Text
  sourceType String   @map("source_type")
  status     String   @default("draft")
  createdAt  DateTime @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id])
  personas       Persona[]
  rounds         Round[]
  debateMessages DebateMessage[]
  analysisResult AnalysisResult?
  judgeSummary   JudgeSummary?

  @@map("debates")
}

model Persona {
  id          String   @id @default(uuid())
  debateId    String   @map("debate_id")
  name        String
  role        String   @default("")
  demographic String
  interests   Json
  fears       Json
  priorities  Json
  color       String
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")

  debate         Debate          @relation(fields: [debateId], references: [id])
  debateMessages DebateMessage[]

  @@map("personas")
}

model Round {
  id          String    @id @default(uuid())
  debateId    String    @map("debate_id")
  roundNumber Int       @map("round_number")
  phase       String
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")

  debate         Debate          @relation(fields: [debateId], references: [id])
  debateMessages DebateMessage[]

  @@index([debateId, roundNumber])
  @@map("rounds")
}

model DebateMessage {
  id        String   @id @default(uuid())
  debateId  String   @map("debate_id")
  roundId   String   @map("round_id")
  personaId String   @map("persona_id")
  content   String   @db.Text
  sequence  Int
  emotion   Emotion  @default(calm)
  createdAt DateTime @default(now()) @map("created_at")

  debate  Debate  @relation(fields: [debateId], references: [id])
  round   Round   @relation(fields: [roundId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id])

  @@index([debateId, createdAt])
  @@index([roundId, sequence])
  @@map("debate_messages")
}

enum Emotion {
  calm
  confident
  pensive
  anxious
  tense
}

model AnalysisResult {
  id                String   @id @default(uuid())
  debateId          String   @unique @map("debate_id")
  affectedGroups    Json     @map("affected_groups")
  keyChanges        Json     @map("key_changes")
  contentiousPoints Json     @map("contentious_points")
  createdAt         DateTime @default(now()) @map("created_at")

  debate Debate @relation(fields: [debateId], references: [id])

  @@map("analysis_results")
}

model JudgeSummary {
  id                String   @id @default(uuid())
  debateId          String   @unique @map("debate_id")
  contradictions    Json
  commonGround      Json     @map("common_ground")
  compromise        Json
  participantShifts Json     @map("participant_shifts")
  closingStatement  String   @map("closing_statement") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  debate Debate @relation(fields: [debateId], references: [id])

  @@map("judge_conclusions")
}
