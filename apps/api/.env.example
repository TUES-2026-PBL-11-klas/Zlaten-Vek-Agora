PORT=3001

# Supabase connection string — get it from your Supabase project settings:
# Settings > Database > Connection string > URI (use the "Transaction" pooler for serverless)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API (used by the client / auth)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# OpenAI
OPENAI_API_KEY=sk-...
