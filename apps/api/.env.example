PORT=3001

# Supabase connection string - get it from your Supabase project settings:
# Settings > Database > Connection string > URI (use the "Transaction" pooler for serverless)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# Direct connection (bypasses PgBouncer) - required by Prisma Migrate
# Settings > Database > Connection string > URI (use "Session" mode or "Direct connection")
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API (used by the client / auth)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Supabase JWT secret - Settings > API > JWT Secret. Used by the NestJS API to verify
# access tokens issued by Supabase Auth. Never commit the real value.
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini (only needed for llm-spike scripts)
GOOGLE_API_KEY=AIza...
