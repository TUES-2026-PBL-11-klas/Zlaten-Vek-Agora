# Copy this file to `.env` at the repo root and adjust as needed.
# ---- API ----
# Host port the api container is published on.
API_PORT=3000
# Inside the docker network the api reaches postgres by service name.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agora
# Supabase is used in staging/prod. For local dev these can stay as mock values.
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=local-dev-jwt-secret-change-me-in-real-environments

# ---- Web ----
WEB_PORT=5173
VITE_API_URL=/api
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=local-dev-anon-key
